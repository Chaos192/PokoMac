// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
// Resources for pkp.exe: the manifest (UTF-8 code page, long paths, asInvoker) and the version information.
// PKP_VER_MAJOR / MINOR / PATCH and PKP_VER_TEXT come from the build (game-build/CMakeLists.txt, -DPKP_VERSION=0.1.0).
#include <winres.h>

#ifndef PKP_VER_MAJOR
#define PKP_VER_MAJOR 0
#define PKP_VER_MINOR 0
#define PKP_VER_PATCH 0
#endif
#ifndef PKP_VER_TEXT
#define PKP_VER_TEXT "dev"
#endif

1 24 "pkp.manifest"

1 VERSIONINFO
FILEVERSION     PKP_VER_MAJOR, PKP_VER_MINOR, PKP_VER_PATCH, 0
PRODUCTVERSION  PKP_VER_MAJOR, PKP_VER_MINOR, PKP_VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "Pokémon Pokopia PC"
            VALUE "FileVersion", PKP_VER_TEXT
            VALUE "InternalName", "pkp"
            VALUE "OriginalFilename", "pkp.exe"
            VALUE "ProductName", "Pokémon Pokopia PC"
            VALUE "ProductVersion", PKP_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
