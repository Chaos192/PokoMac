{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PokoMac",
        "width": 1040,
        "height": 600,
        "minWidth": 900,
        "minHeight": 440,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 },
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "public.app-category.games",
    "shortDescription": "PokoMac launcher (native Apple silicon build)",
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
